{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./cxhub/*"],
      "@shared/*": ["./cxhub/shared/*"],
      "@modules/*": ["./cxhub/modules/*"],
      "next/server": ["./api/next-server.ts"]
    }
  },
  "include": ["worker.ts", "servidor", "api", "cxhub", "backoffice", "testes", "vitest.config.ts"]
}
