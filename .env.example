# Segredos do app GoDeploy cx-hub (66edd698, https://cx-hub.devgogroup.com): a fila do Metabase (/api/v1/*) e as 23
# rotas que o CX Hub tem na Vercel (o resto). No GoDeploy, cada linha abaixo é um segredo do app (setAppSecret ou o
# console), que o Worker lê como env.NOME; o app NÃO lê arquivo .env. Este arquivo lista todos os que o código lê, por
# que existem e o que acontece sem eles. Os valores de verdade ficam só no GoDeploy (e num .env local, que o
# .gitignore não deixa subir). Com valor aqui = o de produção, que não é segredo; sem valor = segredo ou depende de
# quem cadastra.
#
# Legenda: [obrigatória] sem ela, a parte que a usa recusa a chamada ou não funciona · [opcional] tem padrão no código
# ou só liga um comportamento · [segredo] nunca em log, mensagem, commit ou ticket · [já no app] cadastrada antes desta
# migração (2026-11-04).

# ─── 1. Fila do Metabase (/api/v1/*, em produção desde a v2) ─────────────────────────────────────────────────────────
# Os valores aceitos no x-cxhub-fila-token, separados por vírgula (dois durante a troca). Quem chama: o CX Hub na
# Vercel, enquanto existir, e as rotas deste app, que usam o primeiro da lista sem rede (api/filaNoWorker.ts). Sem ele,
# toda chamada à fila recebe 401, inclusive as das rotas, e reenvio, reembolso e cancelamento são recusados.
# [obrigatória] [segredo] [já no app]
CXHUB_FILA_TOKENS=
# Base do Airflow que recebe o lote (http é aceito: decisão de 18/09/2026). Sem ela o cron não dispara a DAG e os
# casos ficam pendentes na fila. [obrigatória] [já no app]
AIRFLOW_BASE_URL=
# Usuário e senha (basic auth) do Airflow para disparar a DAG e ler o resultado no XCom. [obrigatória] [segredo] [já no app]
AIRFLOW_USER=
AIRFLOW_PASSWORD=
# A DAG, a task e a chave do XCom com o resultado por item. Padrões: gobeaute_reenvio_reembolso_etl, gravar, resultado.
# [opcional]
AIRFLOW_DAG_ID=
AIRFLOW_RESULTADO_TASK_ID=
AIRFLOW_RESULTADO_KEY=
# Itens por lote (casos + atualizações). Padrão 200. [opcional]
LOTE_MAX=

# ─── 2. Avisos no Slack (fila e rotas) ────────────────────────────────────────────────────────────────────────────────
# Incoming Webhook do canal dos avisos. A fila manda um por rodada (itens recusados, lote que falhou); as rotas mandam
# o que o CX Hub mandava ao Google Chat (ADR-005: planilha que não gravou, reenvio do bot que degradou, ERP que
# recusou, gold que não atualizou). Sem ele os avisos só vão ao log e o fluxo segue igual (falha aberta, INV-06).
# ⚠ Ainda NÃO está cadastrado no app (listAppSecrets de 2026-11-10): hoje os avisos da fila só vão ao log.
# [opcional, recomendada] [segredo]: quem tem a URL posta no canal
SLACK_ALERT_WEBHOOK_URL=
# Janela do anti-ruído das rotas, em ms: a mesma causa sistêmica vira um aviso por janela. Padrão 900000 (15 min).
# Substitui o GCHAT_ALERT_THROTTLE_MS da Vercel. [opcional]
ALERT_THROTTLE_MS=

# ─── 3. Cosmos (ERP) e login ──────────────────────────────────────────────────────────────────────────────────────────
# Base da API do Cosmos, sem barra no fim. Usada pelo login, /api/cosmos/*, bot, /api/sheets/append (o POST /resend),
# /api/refund/*, /api/registro e /api/solicitacoes (as três últimas só conferem o token). [obrigatória]
COSMOS_API_URL=
# Usuário de serviço do Cosmos: o /api/auth/login devolve o token dele, e o bot assina o próprio token de serviço com
# ele (cacheado até 60 s antes do exp). [obrigatória] [segredo]
COSMOS_EMAIL=
COSMOS_PASSWORD=
# A credencial única que o /api/auth/login compara com o que a tela manda. A senha pode ter "$": cadastre como é (o
# escape \$ da Vercel não é preciso aqui, e a rota aceita os dois jeitos). [obrigatória] [segredo]
CX_HUB_EMAIL=
CX_HUB_PASSWORD=
# Timeout padrão (ms) das chamadas externas. Padrão 10000; o CX Hub da Vercel usa 12000. Entra no orçamento do bot:
# 2× TIMEOUT + as janelas da rota dados, da fila e da planilha precisam caber em 150 s. [opcional]
TIMEOUT=12000
# Orçamento total (ms) da busca do pedido no Cosmos pelo bot (signin + pedido + catálogo + kits). Padrão 25000. [opcional]
COSMOS_FETCH_BUDGET_MS=

# ─── 4. Registro: Metabase (raw e gold) e planilhas Google ────────────────────────────────────────────────────────────
# Leitura do Data Mart (só leitura, réplica): o dedup de 24 h, a lista de solicitações, a tag do registro e a gestão do
# reembolso leem a raw; cancelar e editar reenvio leem da gold o id do caso. As três juntas: faltou uma ⇒
# /api/solicitacoes e /api/registro respondem 503, reenvio e reembolso são recusados (sem dedup) e as atualizações de
# reenvio na gold ficam desligadas, o /api/datamart/products (o catálogo de mimo e troca da Ápice, da Yenzah e da
# Denavita) responde 502, e o pedido que o integrations-gateway não acha (mais de 60 dias) deixa de vir do Data Mart
# (api.vw_shopify_orders). O id é o do Data Mart NESTE Metabase (o da gobeaute; nunca o banco de escrita).
# [obrigatória]
METABASE_URL=https://metabase.gobeaute.com.br
# A chave de API do CX Hub no Metabase (o grupo dela precisa de SQL nativo no Data Mart). [obrigatória] [segredo]
METABASE_API_KEY=
# [obrigatória]
METABASE_DATABASE_ID=43
# Conta de serviço do Google que grava a linha na planilha da marca junto com a fila (ADR-010). Precisa ser editora de
# cada planilha e estar na exceção da proteção das abas. O e-mail não é segredo. [obrigatória]
GOOGLE_PLANILHAS_EMAIL=
# O private_key do JSON da conta de serviço (PKCS#8, assinado pelo WebCrypto do Worker). Aceita \n escrito, quebra de
# linha de verdade ou tudo numa linha. [obrigatória] [segredo]
GOOGLE_PLANILHAS_TOKEN=
# Qual conjunto de planilhas (os IDs estão em cxhub/shared/lib/sheets/targets.ts): prod ou staging. Sem padrão de
# propósito: ausente ou outro valor ⇒ a solicitação é recusada antes do dedup e do Cosmos. [obrigatória]
SHEETS_ENV=prod

# ─── 5. Shopify e integrations-gateway ────────────────────────────────────────────────────────────────────────────────
# X-Shopify-Access-Token da loja de 5 das 6 marcas do Cosmos, no /api/shopify/orders (o pedido quando o Cosmos não o
# tem). Faltou o de uma marca ⇒ 500 só para ela. A Rituária não tem token aqui: o pedido dela vem pelo gateway (abaixo).
# [obrigatória] [segredo]
SHOPIFY_TOKEN_LESCENT=
SHOPIFY_TOKEN_KOKESHI=
SHOPIFY_TOKEN_BYSAMIA=
SHOPIFY_TOKEN_AUA=
SHOPIFY_TOKEN_BARBOURS=
# A chave igw_… (escopo shopify:read) do integrations-gateway: o pedido das marcas sem Cosmos (Ápice, Yenzah, Denavita,
# Gobeaute), no /api/shopify/orders e no bot, e o da Rituária no /api/shopify/orders (o bot da Rituária lê o Cosmos).
# O gateway só enxerga os últimos 60 dias de pedidos; o que ele não acha, ou com ele fora, vem do Data Mart (METABASE_*,
# menos a Gobeaute). Sem ela, o pedido dessas marcas só vem do Data Mart (que não tem o das últimas horas); fora dele, o
# /api/shopify/orders responde 500 e o bot grava a linha só com o que veio (SHOPIFY_UNAVAILABLE). [obrigatória] [segredo]
INTEGRATIONS_GATEWAY_READ_KEY=

# ─── 6. Logística (/api/logistica/submit) ─────────────────────────────────────────────────────────────────────────────
# Base do worker cx-ticketcreator, sem path (a rota acrescenta /gogroup-tickets-clind). Staging:
# https://cx-ticketcreator-staging.rpa-ia.workers.dev. Sem ela ⇒ 500 sem chamar o worker. [obrigatória]
TICKETCREATOR_URL=https://cx-ticketcreator-prod.rpa-ia.workers.dev
# O x-webhook-secret do worker (WEBHOOK_SECRET no Infisical do cx-ticketcreator). Sem ele ⇒ 500 sem chamar o worker
# (falha fechada). [obrigatória] [segredo]
TICKETCREATOR_SECRET=

# ─── 7. Porta do bot (/api/reenvio/bot, o Typebot) ────────────────────────────────────────────────────────────────────
# O segredo do header x-bot-secret, que quem chama manda junto da chave gdk_ do gateway. Quem manda: o Typebot (o bot de
# atendimento, em produção desde 2026-08) e, quando for publicado, o fluxo Extravios Gobeaute do hub Jornada CX (o
# protótipo é o app/extravios-gobeaute do CX Hub). Atrás do gateway ele continua valendo: o login do GoDeploy deixa
# entrar qualquer pessoa do grupo, e esta rota cria pedido no Cosmos. Sem ele a rota recusa TODA requisição com 503
# (falha fechada, INV-04). [obrigatória] [segredo]
BOT_RESEND_SECRET=
# Interruptor de emergência sem deploy: "off" desliga a execução do reenvio no Cosmos (a linha continua registrada).
# Ausente ou outro valor = ligado. [opcional]
BOT_RESEND_EXECUTE=

# ─── 8. Dados do formulário (app GoDeploy rota-dados-cxhub, ADR-009) ──────────────────────────────────────────────────
# /api/resend/data (os dropdowns), as marcas aceitas pelo bot (ADR-015), os motivos do backoffice (seção 10) e a cache
# da rota dados no env.DB, que o cron renova em POST /api/interno/rota-dados (api/cacheDaRotaDados.ts). Com a rota dados
# fora, a cache serve a última resposta boa por até 24 h. URL base, sem path. [obrigatória]
FORM_DATA_API_URL=https://rota-dados-cxhub.devgogroup.com
# O x-form-data-token (um dos valores do FORM_DATA_API_TOKENS daquele app). Sem ele (ou sem a URL) ⇒ /api/resend/data
# responde 500 e o bot aceita todas as marcas do código (falha aberta). [obrigatória] [segredo]
FORM_DATA_API_TOKEN=
# A chave gdk_ do gateway do GoDeploy PARA o app rota-dados-cxhub (Authorization: Bearer). A gdk_ vale por app: a de
# outro app leva 403. Sem ela o gateway de lá responde 302 e o /api/resend/data, 502. [obrigatória] [segredo]
FORM_DATA_GODEPLOY_KEY=

# ─── 9. NÃO cadastrar (o app resolve sozinho, ou não lê) ──────────────────────────────────────────────────────────────
# CXHUB_FILA_URL, CXHUB_FILA_TOKEN, CXHUB_FILA_GODEPLOY_KEY: na Vercel apontavam para este app. Aqui a fila está no
#   mesmo Worker: sem cadastrar, a URL é a origem interna e o token é o primeiro do CXHUB_FILA_TOKENS (api/ambiente.ts).
#   Cadastrar só para mandar as rotas a uma fila de fora.
# VERCEL_ENV: o app se marca como production (api/ambiente.ts).
# COSMOS_RESEND_SIMULADO: só vale fora da produção; aqui é ignorado. Para ensaiar, use o testMode do bot e do
#   /api/sheets/append, que não chamam o Cosmos.
# GCHAT_ALERT_WEBHOOK_URL, GCHAT_ALERT_THROTTLE_MS: não são lidas; os avisos vão ao Slack (seção 2).
# SHOPIFY_TOKEN_RITUARIA: não é lida; o pedido da Rituária na Shopify vem pelo INTEGRATIONS_GATEWAY_READ_KEY (seção 5).
# INTEGRATIONS_GATEWAY_WRITE_KEY: não é lida. É a chave do gateway que ESCREVE na Shopify (nota e endereço do pedido), e
#   o app só lê, com a INTEGRATIONS_GATEWAY_READ_KEY (seção 5). Cadastrada, só aumenta o que um vazamento expõe.
# NEXT_PUBLIC_GESTAO_HABILITADA: só da tela do CX Hub.
# APP_ORIGIN: o backoffice (seção 10) aceita escrita de navegador só da origem do próprio app, e esta variável somaria
#   outra origem. Aqui quem chama é servidor (sem Origin), e nenhuma página de outro domínio é autorizada.
# GODEPLOY_CRON_KEY: a plataforma injeta (é a chave do HMAC do X-Godeploy-Cron do cron da fila).

# ─── 10. Backoffice de reenvio e reembolso (/api/backoffice/*, portado do app backoffice-hub) ──────────────────────────
# Nenhum segredo novo: o backoffice lê os mesmos nomes que o app de origem lia, e os valores são os deste app.
#   METABASE_URL, METABASE_API_KEY, METABASE_DATABASE_ID (seção 4): a lista (gold + raw), o pedido e o catálogo do mimo
#     no Data Mart, e a conferência na raw das edições gravadas. Sem eles, a lista e o caso respondem 503.
#   FORM_DATA_* (seção 8): os motivos, pela cache da rota dados.
# O backoffice não tem lote próprio (fila única): a edição é uma atualização da fila (seção 1) e sobe no lote dela, com
# o Airflow, o LOTE_MAX, o Slack (seção 2) e o GODEPLOY_CRON_KEY da fila. Sem o Airflow, as edições ficam pendentes na
# fila, como os casos.
